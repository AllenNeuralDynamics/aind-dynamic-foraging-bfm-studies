{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "launch-record.v2",
  "title": "Launch record",
  "description": "One JSON per launch or intervention, under studies/<study>/variants/<variant>/launch_record/. Written by the dispatcher launchers and studies/util/launch_record.py. Terms: CONTEXT.md (Launch, Intervention, W&B group); rules: docs/adr/0001. Records without `_meta.schema_version: 2` are v1 (frozen history) and only warn.",
  "type": "object",
  "required": ["_meta", "kind", "platform", "wandb_group", "label", "note", "job_refs", "revisions", "manifests"],
  "properties": {
    "_meta": {
      "type": "object", "required": ["schema_version", "produced_by", "produced_at_pt"],
      "properties": {"schema_version": {"const": 2}}
    },
    "kind": {"enum": ["initial", "resubmit", "rescue", "probe", "tier-change", "backfill", "extend"]},
    "platform": {"enum": ["beaker", "hpc", "none"], "description": "`none` only for kind backfill, which submits nothing."},
    "wandb_group": {"type": "string", "pattern": "^[A-Za-z0-9][\\w.-]*@[0-9]{8}-[0-9]{6}$",
                    "description": "Prefix before `@` equals the variant directory name."},
    "label": {"type": "string", "minLength": 1},
    "note": {"type": "string", "minLength": 10, "description": "The launcher --note: why the run exists and what it should teach us."},
    "job_refs": {
      "type": "array",
      "items": {
        "type": "object", "required": ["type", "id"],
        "properties": {
          "type": {"enum": ["beaker_experiment", "wandb_sweep", "slurm_array_job", "slurm_job"]},
          "id": {"type": "string", "minLength": 1}
        }
      }
    },
    "revisions": {
      "type": "object", "required": ["studies", "dispatcher", "wrapper"],
      "additionalProperties": false,
      "properties": {
        "studies": {"$ref": "#/$defs/sha"},
        "dispatcher": {"$ref": "#/$defs/sha"},
        "wrapper": {"$ref": "#/$defs/sha"},
        "foraging_models": {"$ref": "#/$defs/sha"}
      }
    },
    "manifests": {"type": "array", "minItems": 1, "items": {"type": "string"},
                  "description": "Variant-relative paths of the submitted sweep/experiment manifests."},
    "n_tasks": {"type": "integer", "minimum": 1},
    "supersedes": {"type": "array", "items": {"type": "string"}},
    "trigger": {
      "type": ["object", "null"],
      "properties": {"symptom": {"type": "string"}, "cause": {"type": "string"}, "evidence": {}}
    },
    "deviations": {"type": "object", "description": "Manifest fields that differ from the launch's, field -> value or true."},
    "cost": {"type": "object"},
    "tasks": {"type": "array"},
    "data": {
      "type": "object", "required": ["source", "config"], "additionalProperties": false,
      "description": "What the runs trained and were evaluated on. snapshot: a dated, immutable copy of the foraging database, by id and the sha256 of its snapshot_manifest.json; live: the growing database (not reproducible; launchers refuse it without --allow-live-data); generated: a synthetic population defined by the config itself; external: a dataset outside the foraging database, read by a non-Hydra runner (e.g. study 09's external_transfer), named in `config`.",
      "properties": {
        "source": {"enum": ["snapshot", "live", "generated", "external"]},
        "config": {"type": "string", "description": "The Hydra data config, e.g. mice_snapshot_scaling; for an external source, the runner and its dataset argument."},
        "type": {"type": ["string", "null"], "description": "The data config's `type`, e.g. mice_snapshot."},
        "snapshot": {"type": ["string", "null"]},
        "uri": {"type": ["string", "null"]},
        "manifest_sha256": {"$ref": "#/$defs/sha256_or_null"},
        "build_id": {"type": ["string", "integer", "null"]},
        "n_sessions": {"type": ["integer", "null"]}
      },
      "if": {"properties": {"source": {"const": "snapshot"}}},
      "then": {"required": ["snapshot", "uri", "manifest_sha256"], "properties": {"snapshot": {"type": "string", "minLength": 1}}}
    },
    "image": {
      "description": "The environment the code ran in. Beaker: the image name from the experiment template and the immutable image id it resolved to at submit. HPC: the conda env the job activated and a sha256 over its installed packages.",
      "oneOf": [
        {"type": "object", "required": ["platform", "name", "id"], "additionalProperties": false,
         "properties": {"platform": {"const": "beaker"}, "name": {"type": "string", "minLength": 1}, "id": {"type": ["string", "null"]}}},
        {"type": "object", "required": ["platform", "conda_env", "lock_sha256"], "additionalProperties": false,
         "properties": {"platform": {"const": "hpc"}, "conda_env": {"type": "string", "minLength": 1}, "lock_sha256": {"$ref": "#/$defs/sha256_or_null"}}}
      ]
    }
  },
  "allOf": [
    {"if": {"properties": {"kind": {"not": {"const": "initial"}}}},
     "then": {"required": ["trigger"], "properties": {"trigger": {"type": "object", "required": ["symptom", "cause"]}}}},
    {"if": {"properties": {"kind": {"const": "backfill"}}},
     "then": {"properties": {"platform": {"const": "none"}, "job_refs": {"maxItems": 0}}},
     "else": {"properties": {"platform": {"enum": ["beaker", "hpc"]}, "job_refs": {"minItems": 1}}}}
  ],
  "$defs": {"sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "sha256_or_null": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}}
}
