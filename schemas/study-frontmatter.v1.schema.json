{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "study-frontmatter.v1",
  "title": "Study cover",
  "description": "YAML frontmatter of studies/<study>/README.md. Terms: CONTEXT.md (Study, Study status, Motivation, Tag). Study dependencies are derived from report `upstream`, not declared here; `motivated_by` records why the study exists.",
  "type": "object",
  "required": ["schema_version", "id", "question", "status", "wandb", "motivated_by", "tags"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[0-9]{2}-[a-z0-9]+-[a-z0-9-]+$", "description": "Equals the directory name."},
    "question": {"type": "string", "minLength": 10},
    "status": {"enum": ["planned", "active", "complete", "superseded"]},
    "superseded_by": {"type": "string", "pattern": "^[0-9]{2}-[a-z0-9]+-[a-z0-9-]+$"},
    "wandb": {
      "type": "object", "required": ["entity", "project"], "additionalProperties": false,
      "properties": {"entity": {"type": "string"}, "project": {"type": "string"}}
    },
    "issues": {
      "type": "array",
      "items": {"oneOf": [
        {"type": "integer", "minimum": 1},
        {"type": "string", "pattern": "^AllenNeuralDynamics/[\\w.-]+#[0-9]+$"}
      ]}
    },
    "verdict": {"type": "string", "maxLength": 200},
    "tags": {
      "type": "object",
      "description": "What the study asks (CONTEXT.md, Tag). Values come from schemas/tags.yaml; the checker rejects others. They place the study on the atlas map.",
      "required": ["model", "question"], "additionalProperties": false,
      "properties": {
        "model": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9-]+(/[a-z0-9-]+)*$"}, "minItems": 1, "uniqueItems": true},
        "question": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9-]+(/[a-z0-9-]+)*$"}, "minItems": 1, "uniqueItems": true}
      }
    },
    "motivated_by": {
      "type": "array",
      "description": "Why this study exists (CONTEXT.md, Motivation): the earlier results it follows up; entries are equal and none is primary. [] marks a root study. Each note says what that result showed.",
      "items": {"oneOf": [
        {"type": "object", "required": ["study", "report", "note"], "additionalProperties": false,
         "properties": {"study": {"type": "string", "pattern": "^[0-9]{2}-[a-z0-9]+-[a-z0-9-]+$"}, "report": {"type": "string", "pattern": "^r[0-9]+$"},
                        "note": {"type": "string", "minLength": 10}}},
        {"type": "object", "required": ["study", "note"], "additionalProperties": false,
         "properties": {"study": {"type": "string", "pattern": "^[0-9]{2}-[a-z0-9]+-[a-z0-9-]+$"}, "note": {"type": "string", "minLength": 10}}},
        {"type": "object", "required": ["issue", "note"], "additionalProperties": false,
         "properties": {"issue": {"oneOf": [{"type": "integer", "minimum": 1},
                                            {"type": "string", "pattern": "^AllenNeuralDynamics/[\\w.-]+#[0-9]+$"}]},
                        "note": {"type": "string", "minLength": 10}}}
      ]}
    }
  },
  "if": {"properties": {"status": {"const": "superseded"}}},
  "then": {"required": ["superseded_by"]}
}
