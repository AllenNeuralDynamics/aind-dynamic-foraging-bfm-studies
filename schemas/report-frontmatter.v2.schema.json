{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "report-frontmatter.v2",
  "title": "Report frontmatter, version 2",
  "description": "YAML frontmatter of studies/<study>/analysis/reports/rN-<slug>.md: version 1 plus `claims`, `draft_reason` and `prose_reviewed`. The body rules (skeleton, claim pointers, stale prose, prose numbers, generated verdicts) are in schemas/README.md, Version-2 reports. Terms: CONTEXT.md (Report, Report status, Correction, Upstream).",
  "type": "object",
  "required": ["schema_version", "id", "slug", "status", "authors", "wandb_groups", "inputs", "claims", "prose_reviewed", "reproduce"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 2},
    "id": {"type": "string", "pattern": "^r[0-9]+$", "description": "Equals the filename prefix."},
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "description": "Equals the filename after `rN-`."},
    "status": {"enum": ["draft", "live", "superseded", "retracted"]},
    "draft_reason": {"$ref": "#/$defs/line", "description": "Required when status is draft: what keeps the report from live, in one line."},
    "superseded_by": {"$ref": "#/$defs/report_ref", "description": "Required when status is superseded."},
    "authors": {"type": "array", "items": {"type": "string"}, "minItems": 1, "description": "The first entry is the report's lead scientist, whose go-ahead takes it live."},
    "issue": {"$ref": "#/$defs/issue_ref"},
    "tags": {
      "type": "object",
      "description": "What this report does (CONTEXT.md, Tag), from schemas/tags.yaml. The atlas filters a study by its own tags plus its reports'.",
      "additionalProperties": false,
      "properties": {
        "model": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9-]+(/[a-z0-9-]+)*$"}, "uniqueItems": true},
        "question": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9-]+(/[a-z0-9-]+)*$"}, "uniqueItems": true}
      }
    },
    "aliases": {"type": "array", "items": {"type": "string"}},
    "wandb_groups": {
      "type": "array",
      "description": "Exact W&B group names, never globs. [] for a report that reads no W&B data.",
      "items": {"$ref": "#/$defs/wandb_group"},
      "uniqueItems": true
    },
    "inputs": {
      "type": "object",
      "description": "role -> study-relative path(s) that exist. Commands and other studies go in `upstream`.",
      "minProperties": 1,
      "additionalProperties": {
        "oneOf": [
          {"$ref": "#/$defs/path"},
          {"type": "array", "items": {"$ref": "#/$defs/path"}, "minItems": 1}
        ]
      }
    },
    "upstream": {
      "type": "array",
      "description": "What this report uses from outside its own study, or cannot express as a path.",
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/report_ref"},
          {"type": "object", "required": ["study", "wandb_group"], "additionalProperties": false,
           "properties": {"study": {"$ref": "#/$defs/study_id"}, "wandb_group": {"$ref": "#/$defs/wandb_group"}}},
          {"type": "object", "required": ["command"], "additionalProperties": false,
           "properties": {"command": {"type": "string", "minLength": 1}, "note": {"type": "string"}}}
        ]
      }
    },
    "corrects": {
      "type": "array",
      "description": "Earlier reports whose conclusion this report amends. The corrected report is not edited.",
      "items": {"allOf": [{"$ref": "#/$defs/report_ref"}, {"required": ["note"]}]},
      "minItems": 1
    },
    "claims": {
      "type": "array",
      "description": "The findings, headline first, and the only home of the report's verdict: the INDEX.md table and the README `## Verdict` are generated from them (scripts/report_verdicts.py).",
      "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "text", "pointer"], "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^F[1-9][0-9]*$", "description": "F1, F2, ...; prose cites a finding by its id."},
          "text": {"$ref": "#/$defs/line", "description": "The finding in one sentence."},
          "pointer": {"type": "string", "pattern": "^(?!/)[^\\s#*?<>|]+\\.json#(/([^~/]|~[01])*)+$",
                      "description": "<study-relative JSON path>#<RFC 6901 JSON Pointer> to the value that supports the claim; it must resolve."}
        }
      }
    },
    "prose_reviewed": {
      "type": "object", "required": ["date", "blocks"], "additionalProperties": false,
      "description": "When the hand-written prose was last re-read, and the digest of every BEGIN/END block it was read against (studies/util/_meta.py block_digest). The checker warns when a block no longer matches.",
      "properties": {
        "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "blocks": {"type": "object", "propertyNames": {"pattern": "^[\\w.-]+$"},
                   "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
      }
    },
    "reproduce": {"type": "string", "pattern": "^make -C studies/[0-9]{2}-[a-z0-9-]+ r[0-9]+$"}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "superseded"}}}, "then": {"required": ["superseded_by"]}},
    {"if": {"properties": {"status": {"const": "draft"}}}, "then": {"required": ["draft_reason"]}}
  ],
  "$defs": {
    "line": {"type": "string", "pattern": "^[^\\n]*\\S[^\\n]*$"},
    "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\s)(?!.*[*?<>|]).+$"},
    "study_id": {"type": "string", "pattern": "^[0-9]{2}-[a-z0-9]+-[a-z0-9-]+$"},
    "wandb_group": {"type": "string", "pattern": "^[A-Za-z0-9][\\w.-]*@[0-9]{8}-[0-9]{6}$"},
    "issue_ref": {
      "oneOf": [
        {"type": "integer", "minimum": 1, "description": "An issue on this (studies) repository."},
        {"type": "string", "pattern": "^AllenNeuralDynamics/[\\w.-]+#[0-9]+$"}
      ]
    },
    "report_ref": {
      "type": "object", "required": ["study", "report"], "additionalProperties": false,
      "properties": {
        "study": {"$ref": "#/$defs/study_id"},
        "report": {"type": "string", "pattern": "^r[0-9]+$"},
        "note": {"type": "string", "minLength": 1}
      }
    }
  }
}
