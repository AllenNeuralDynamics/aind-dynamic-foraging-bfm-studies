 "cards": [
  {
   "dot": "cyan",
   "title": "Where the seams are",
   "items": [
    "Statistics live in aind-dynamic-foraging-models and import nothing from the disRNN stack",
    "HB has no entrypoint of its own: run_hpc dispatches on a Hydra _target_, as it does for every model",
    "The dispatcher owns only the model config, cohort choice and provenance"
   ]
  },
  {
   "dot": "amber",
   "title": "What keeps held-out held out",
   "items": [
    "The population level is fitted on training subjects only, then frozen",
    "A scored session's own parameters are never inferred; they are drawn fresh",
    "The matched rung conditions on exactly the sessions the per-mouse MLE fits"
   ]
  },
  {
   "dot": "emerald",
   "title": "Measured, not assumed",
   "items": [
    "One-stage joint fit at D\u224830 took 3 h 32 m; sequential two-stage passed 5 h 45 m unfinished",
    "likelihood.py is validated by parity against the numpy foragers, not against Stan",
    "artifacts.save_fit persists posterior draws beside both repos' git SHAs"
   ]
  }
 ]
