  "cards": [
    {
      "dot": "violet",
      "title": "How proposals grow",
      "items": [
        "Five islands, each from its own seed: a near-empty template, Miller-RHG, Lopez-DoubleTrace, Lebedeva-PR, Eckstein-BI (ranked on validation mice)",
        "Each proposal edits a parent from its island's archive, with other elites as inspirations: a diff, a full rewrite, or a crossover",
        "Claude Opus 5.5 at effort medium; one repair attempt when an edit does not apply",
        "Islands evolve apart; every 10 generations, 10% of programs migrate"
      ]
    },
    {
      "dot": "cyan",
      "title": "What Claude sees",
      "items": [
        "Prompt: the task, the 19 literature models as a library, the limits",
        "Validation mice: one number per program, its score",
        "Generation mice: score by stage group × task variant",
        "Switch-probability gaps: after losses, after the last 1–3 trials, by reward × run length",
        "Fitted parameters: median [10th–90th percentile], flagged when most mice sit at a bound"
      ]
    },
    {
      "dot": "rose",
      "title": "Rules fixed before the search",
      "items": [
        "Stop at $450, or after 2,000 proposals with no rise > 0.03 over the anchor",
        "Pre-register the best program and the best at each floor; each is the best of 5 on selection mice",
        "Fingerprint gate: skip a candidate whose replay or rollout gap exceeds the best literature model's",
        "Test mice are scored once; nothing scored on them feeds back"
      ]
    },
    {
      "dot": "amber",
      "title": "Headline",
      "items": [
        "Gap closed on the 146 test mice shared with the GRU",
        "GRU = ceiling, HB-CTT = best hierarchical cognitive baseline; read from studies 01 and 13",
        "Every mouse is fitted on its even sessions and scored on its odd sessions, as every comparator was"
      ]
    }
  ]
}
